# Mzian.net — default environment configuration.
#
# Files loaded (latter wins): .env, .env.local, .env.$APP_ENV, .env.$APP_ENV.local
# Real environment variables always win over .env files.
#
# DO NOT PUT PRODUCTION SECRETS IN THIS FILE OR ANY OTHER COMMITTED FILE.
# Use real environment variables, `.env.local` (git-ignored) or `bin/console secrets:set`.
# See .env.example for the documented list of every variable.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker stack default (service "database"). For a host-only setup use e.g.
# DATABASE_URL="mysql://mzian:mzian@127.0.0.1:3306/mzian?serverVersion=8.4.0&charset=utf8mb4"
DATABASE_URL="mysql://mzian:mzian@database:3306/mzian?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Redis is used in the Docker stack. "doctrine://default" works without Redis.
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async&auto_setup=0
MESSENGER_NOTIFICATIONS_TRANSPORT_DSN=doctrine://default?queue_name=notifications&auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> mzian ###
# Base URL used in e-mails and generated links (no trailing slash).
MZIAN_PUBLIC_BASE_URL=http://localhost
# Base URL the worker uses to reach this app (QA checks of preview deployments).
MZIAN_INTERNAL_BASE_URL=http://localhost
MZIAN_MAIL_FROM=no-reply@mzian.net
MZIAN_ADMIN_EMAIL=admin@mzian.net

# 32-byte key, base64 encoded, used to encrypt provider credentials and delivered
# customer credentials (libsodium secretbox). Generate one with:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
MZIAN_ENCRYPTION_KEY=

# Default provider drivers when no provider is configured in the admin.
# "mock" providers never spend money and never call external APIs.
MZIAN_AI_PROVIDER=mock
MZIAN_PAYMENT_PROVIDER=mock

# Optional external API keys (read only when the matching provider is enabled).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_ORGANIZATION=
GITHUB_WEBHOOK_SECRET=
# Shared secret used to sign/verify webhooks sent by mock and generic providers.
MZIAN_WEBHOOK_SECRET=

# Simulated latency (ms) of mock providers, useful to watch the pipeline progress.
MZIAN_MOCK_LATENCY_MS=0
###< mzian ###

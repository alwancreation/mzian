# =============================================================================
# Mzian.net — documented environment variables
# =============================================================================
# Copy to `.env.local` (git-ignored) and adapt. NEVER commit real secrets.
# In production, inject these as real environment variables (Docker secrets,
# orchestrator secrets, CI secrets) or use `bin/console secrets:set`.

# --- Symfony -----------------------------------------------------------------
APP_ENV=dev                       # dev | test | prod
APP_SECRET=change-me              # random string, unique per environment
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost      # used to build URLs from CLI / workers

# --- Infrastructure ----------------------------------------------------------
DATABASE_URL="mysql://mzian:mzian@database:3306/mzian?serverVersion=8.4.0&charset=utf8mb4"
# MariaDB example:
# DATABASE_URL="mysql://mzian:mzian@database:3306/mzian?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=redis://redis:6379/async                       # or doctrine://default?queue_name=async&auto_setup=0
MESSENGER_NOTIFICATIONS_TRANSPORT_DSN=redis://redis:6379/notifications  # or doctrine://default?queue_name=notifications&auto_setup=0
LOCK_DSN=redis://redis:6379                           # or flock
MAILER_DSN=smtp://mailpit:1025                        # e.g. smtp://user:pass@smtp.example.com:587

# --- Mzian application -------------------------------------------------------
MZIAN_PUBLIC_BASE_URL=http://localhost     # public URL (e-mails, links)
MZIAN_INTERNAL_BASE_URL=http://nginx       # URL the worker uses to reach the app (QA checks)
MZIAN_APPS_PUBLIC_URL=http://localhost:8081   # local deployments ("apps" service), public address
MZIAN_APPS_INTERNAL_URL=http://apps:8081      # local deployments, address reachable by the QA agent
MZIAN_MAIL_FROM=no-reply@mzian.net
MZIAN_ADMIN_EMAIL=admin@mzian.net          # receives "approval required" notifications

# 32 random bytes, base64 encoded. Encrypts provider credentials and customer
# credentials at rest (libsodium secretbox). Rotating it requires re-encryption.
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
MZIAN_ENCRYPTION_KEY=

# Shared secret used to sign/verify webhooks from mock/generic providers
# (header "X-Mzian-Signature: t=<timestamp>,v1=<hmac-sha256>").
MZIAN_WEBHOOK_SECRET=

# Default drivers used until a default provider is configured in Admin > Providers.
MZIAN_AI_PROVIDER=mock                     # mock | openai | claude
MZIAN_PAYMENT_PROVIDER=mock                # mock | manual | stripe
MZIAN_REPOSITORY_PROVIDER=local_git        # local_git | github (needs GITHUB_TOKEN)
# Mock payments are refused when APP_ENV=prod (they would give projects away for free).
# MZIAN_ALLOW_MOCK_PAYMENTS=1               # only for a public demo, never for real customers

# Mock providers simulated latency in milliseconds (0 = instant).
MZIAN_MOCK_LATENCY_MS=0

# --- AI providers (only read when enabled) ------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Payments ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Repositories (client project repositories) -------------------------------
GITHUB_TOKEN=                # fine-grained token: repo administration + contents only
GITHUB_ORGANIZATION=         # organization owning the mzian-client-* repositories

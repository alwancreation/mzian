# Production defaults (committed, NON-SECRET values only).
# Every secret (APP_SECRET, MZIAN_ENCRYPTION_KEY, API keys, database password...)
# MUST be injected as a real environment variable or via `bin/console secrets:set`.
APP_DEBUG=0
MESSENGER_TRANSPORT_DSN=redis://redis:6379/async
MESSENGER_NOTIFICATIONS_TRANSPORT_DSN=redis://redis:6379/notifications
LOCK_DSN=redis://redis:6379
MZIAN_MOCK_LATENCY_MS=0

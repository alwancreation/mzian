{
  "$comment": "Website copy generated for a customer application (Development Agent).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tagline", "about", "services", "call_to_action", "seo_title", "seo_description"],
  "properties": {
    "tagline": { "type": "string", "minLength": 3, "maxLength": 140 },
    "about": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "description": { "type": "string", "minLength": 5, "maxLength": 300 }
        }
      }
    },
    "call_to_action": { "type": "string", "minLength": 2, "maxLength": 60 },
    "seo_title": { "type": "string", "minLength": 10, "maxLength": 70 },
    "seo_description": { "type": "string", "minLength": 30, "maxLength": 170 }
  }
}

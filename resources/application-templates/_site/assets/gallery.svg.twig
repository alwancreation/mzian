<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" role="img" aria-label="{{ site.name }}"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="{{ index is odd ? site.theme.primary : site.theme.accent }}" stop-opacity=".85"/><stop offset="1" stop-color="{{ index is odd ? site.theme.accent : site.theme.primary }}" stop-opacity=".55"/></linearGradient></defs><rect width="600" height="400" fill="url(#g)"/><text x="300" y="215" font-size="96" text-anchor="middle">{{ site.theme.hero }}</text></svg>

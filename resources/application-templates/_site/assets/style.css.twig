/* Generated by Mzian.net — theme: {{ site.theme.primary }} / {{ site.theme.accent }} */
:root{--p:{{ site.theme.primary }};--a:{{ site.theme.accent }};--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;--bg:#fff;--soft:#f8fafc;--r:16px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans Arabic",sans-serif;color:var(--ink);background:var(--bg)}
img{max-width:100%;height:auto;display:block}a{color:var(--p)}h1,h2,h3{line-height:1.2}h1{font-size:clamp(2rem,5vw,3.2rem);margin:.2em 0}h2{font-size:1.6rem}
.wrap{max-width:1120px;margin:auto;padding:0 1rem}.section{padding:3rem 1rem}.narrow{max-width:760px}.center{text-align:center}.small{font-size:.85rem}.muted{color:var(--muted)}
.sr,.skip:not(:focus){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.skip:focus{position:fixed;top:.5rem;left:.5rem;background:#fff;padding:.5rem;z-index:20}
.top{position:sticky;top:0;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);z-index:10}.bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:64px}
.brand{font-weight:800;text-decoration:none;color:var(--ink);display:flex;align-items:center;gap:.5rem}.logo{font-size:1.4rem}
.nav{display:flex;gap:1.1rem;align-items:center;flex-wrap:wrap}.nav a{text-decoration:none;color:var(--ink);font-weight:600}.nav a[aria-current=page]{color:var(--p)}.langs{display:flex;gap:.4rem}.langs a{font-size:.8rem;border:1px solid var(--line);border-radius:999px;padding:.1rem .5rem}
.burger{display:none;border:1px solid var(--line);background:#fff;border-radius:10px;padding:.4rem .7rem;font-size:1.1rem}
.hero{background:radial-gradient(circle at 20% 20%,color-mix(in srgb,var(--p) 18%,#fff),#fff 60%),linear-gradient(135deg,color-mix(in srgb,var(--a) 12%,#fff),#fff);padding:5rem 0 4rem}.eyebrow{color:var(--p);font-weight:700}.lead{font-size:1.2rem;color:#334155;max-width:46rem}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}
.btn{display:inline-block;background:var(--p);color:#fff;border:0;border-radius:12px;padding:.7rem 1.2rem;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.btn:hover{filter:brightness(.95)}.btn.big{padding:.9rem 1.6rem;font-size:1.05rem}.btn.small{padding:.45rem .8rem;font-size:.9rem}.btn.ghost{background:#fff;color:var(--p);border:2px solid var(--p)}
.grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}.grid.two{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid.three{grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.2rem;box-shadow:0 1px 2px rgba(15,23,42,.04)}.item h3{margin:0 0 .4rem}.price{font-size:1.25rem;font-weight:800;color:var(--p);margin:.4rem 0}.tag{display:inline-block;background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:.05rem .6rem;margin:.1rem .2rem .1rem 0;font-size:.82rem}
.head{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.highlights{list-style:none;padding:0}.checks{list-style:none;padding:0}.checks li{margin:.4rem 0}.stack{display:grid;gap:1rem;align-content:start}
.cta{text-align:center;background:var(--soft);border-radius:var(--r);margin-bottom:3rem}
.form .fields{display:grid;gap:.9rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.form label{display:block;font-weight:600;font-size:.92rem}.form .wide{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:.3rem;padding:.65rem .75rem;border:1px solid #cbd5e1;border-radius:12px;font:inherit;background:#fff}input:focus,select:focus,textarea:focus{outline:2px solid var(--p);outline-offset:1px}
.hp{position:absolute;left:-9999px}.alert{border-radius:12px;padding:.8rem 1rem;margin-bottom:1rem}.alert.ok{background:#ecfdf5;color:#065f46}.alert.ko{background:#fff1f2;color:#9f1239}
.map iframe{width:100%;height:260px;border:0;border-radius:12px}.gallery figure{margin:0;padding:.5rem}.gallery img{border-radius:12px}
.cart-lines{list-style:none;padding:0}.cart-lines li{display:flex;justify-content:space-between;gap:.5rem;border-bottom:1px solid var(--line);padding:.5rem 0}.cart-lines button{background:none;border:0;color:#be123c;cursor:pointer}.total{font-size:1.2rem}
.foot{background:#0f172a;color:#cbd5e1;padding:2.5rem 0 1rem;margin-top:2rem}.foot a{color:#fff}.foot .brand{color:#fff}.cols{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.newsletter .inline{display:flex;gap:.5rem}.newsletter input{margin:0}
.wa{position:fixed;bottom:1.2rem;inset-inline-end:1.2rem;width:58px;height:58px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:1.6rem;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.2);z-index:9}
@media (max-width:760px){.burger{display:block}.nav{display:none;position:absolute;top:64px;left:0;right:0;background:#fff;flex-direction:column;align-items:flex-start;padding:1rem;border-bottom:1px solid var(--line)}.nav.open{display:flex}.hero{padding:3rem 0}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

{#- Generated by Mzian.net. Variables: site, page. -#}
<!doctype html>
<html lang="{{ site.locale }}" dir="{{ site.dir }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.seo_title }}</title>
    <meta name="description" content="{{ page.seo_description }}">
    <link rel="canonical" href="{{ page.url }}">
    {%- for language in site.languages %}
    <link rel="alternate" hreflang="{{ language.code }}" href="{{ language.base }}{{ page.file == 'index.html' ? '' : page.file }}">
    {%- endfor %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.seo_title }}">
    <meta property="og:description" content="{{ page.seo_description }}">
    <meta property="og:url" content="{{ page.url }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta name="theme-color" content="{{ site.theme.primary }}">
    <link rel="icon" href="{{ site.root }}assets/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="{{ site.root }}site.webmanifest">
    <link rel="stylesheet" href="{{ site.root }}assets/style.css">
    <script type="application/ld+json">{{ site.jsonld|raw }}</script>
</head>
<body data-root="{{ site.root }}" data-store="mzian-cart-{{ site.slug }}" data-currency="{{ site.currency }}">
<a class="skip" href="#main">{{ site.t.menu_open }}</a>
<header class="top">
    <div class="wrap bar">
        <a class="brand" href="{{ site.root ~ site.prefix }}index.html"><span class="logo" aria-hidden="true">{{ site.theme.hero }}</span>{{ site.name }}</a>
        <button class="burger" type="button" aria-controls="nav" aria-expanded="false" data-toggle="nav">☰<span class="sr">{{ site.t.menu_open }}</span></button>
        <nav id="nav" class="nav" aria-label="{{ site.t.menu_open }}">
            {%- for item in site.nav %}
            <a href="{{ item.file }}"{% if item.file == page.file %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {%- endfor %}
            {%- if site.has_cart %}<a href="checkout.html" class="cart-link">🛒 <span data-cart-count>0</span></a>{% endif %}
            {%- if site.languages|length > 1 %}
            <span class="langs" aria-label="{{ site.t.language }}">
                {%- for language in site.languages %}<a href="{{ site.root ~ language.prefix ~ page.file }}" hreflang="{{ language.code }}" lang="{{ language.code }}"{% if language.code == site.locale %} aria-current="true"{% endif %}>{{ language.code|upper }}</a>{% endfor -%}
            </span>
            {%- endif %}
        </nav>
    </div>
</header>
<main id="main">
{% block content %}{% endblock %}
</main>
<footer class="foot">
    <div class="wrap cols">
        <div>
            <p class="brand">{{ site.theme.hero }} {{ site.name }}</p>
            {% if site.city %}<p>{{ site.t.address }} : {{ site.city }}</p>{% endif %}
            {% if site.phone %}<p><a href="tel:{{ site.phone_link }}">{{ site.phone }}</a></p>{% endif %}
            {% if site.email %}<p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>{% endif %}
        </div>
        {% if site.hours %}
        <div>
            <p class="brand">{{ site.t.hours }}</p>
            {% for line in site.hours %}<p>{{ line }}</p>{% endfor %}
        </div>
        {% endif %}
        {% if site.newsletter %}
        <form class="newsletter" method="post" action="{{ site.root }}admin/index.php?public=submit&amp;entity=subscribers">
            <label for="nl-email" class="brand">{{ site.t.newsletter }}</label>
            <input type="hidden" name="_return" value="../{{ site.prefix ~ page.file }}">
            <div class="hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
            <div class="inline"><input id="nl-email" type="email" name="email" required placeholder="{{ site.t.newsletter_placeholder }}"><button class="btn">{{ site.t.subscribe }}</button></div>
        </form>
        {% endif %}
    </div>
    <div class="wrap small">
        <p>© {{ site.year }} {{ site.name }}. {{ site.t.rights }} · <a href="legal.html">{{ site.t.legal }}</a></p>
        <p class="muted">{{ site.t.made_with }}</p>
    </div>
</footer>
{% if site.whatsapp %}
<a class="wa" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="{{ site.t.whatsapp }}">💬<span class="sr">{{ site.t.whatsapp }}</span></a>
{% endif %}
<script src="{{ site.root }}assets/app.js" defer></script>
</body>
</html>

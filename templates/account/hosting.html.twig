{% extends 'layouts/account.html.twig' %}

{% block title %}{{ 'account.nav.hosting'|trans }}{% endblock %}
{% block page_title %}{{ 'account.nav.hosting'|trans }}{% endblock %}

{% block account_content %}
{% if accounts is empty %}
    {% include 'components/_empty.html.twig' with {icon: '🗄️', title: 'account.empty.hosting'|trans} %}
{% else %}
    <div class="grid gap-4 md:grid-cols-2">
        {% for account in accounts %}
            <div class="card card-body">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-xs text-slate-500">{{ account.project.name }}</p>
                        <p class="font-semibold">{{ account.plan ? account.plan.name : account.provider }}</p>
                    </div>
                    <span class="badge-gray">{{ ('hosting.statuses.' ~ account.status.value)|trans }}</span>
                </div>
                <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
                    <div><dt class="text-slate-500">{{ 'hosting.region'|trans }}</dt><dd>{{ account.region ?: '—' }}</dd></div>
                    <div><dt class="text-slate-500">{{ 'hosting.expires'|trans }}</dt><dd>{{ account.expiresAt ? account.expiresAt|format_date('medium', locale: app.request.locale) : '—' }}</dd></div>
                </dl>
                {% if account.simulated %}<p class="mt-3"><span class="badge-amber">{{ 'project.simulated'|trans }}</span></p>{% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}

{% extends 'layouts/account.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}
{% block page_title %}{{ project.name }}{% endblock %}

{% block account_content %}
{% set status = project.status %}
{% set polling = status.automation or status.value in ['PENDING_ADMIN_APPROVAL', 'PAID'] %}
<div {% if polling %}data-poll-url="{{ path('account_project_status', {reference: project.reference}) }}" data-poll-status="{{ status.value }}" data-poll-progress="{{ project.progress }}"{% endif %}>
    <div class="card card-body">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-xs text-slate-500">{{ project.reference }}</p>
                <div class="mt-1 flex flex-wrap items-center gap-2">
                    <span class="{{ status.badge }}">{{ status.translationKey|trans }}</span>
                    {% if project.simulated %}<span class="badge-amber" title="{{ 'project.simulated_help'|trans }}">{{ 'project.simulated'|trans }}</span>{% endif %}
                    {% if polling %}<span class="badge-violet">● {{ 'project.live'|trans }}</span>{% endif %}
                </div>
            </div>
            {% if project.deploymentUrl %}
                <a href="{{ project.deploymentUrl }}" target="_blank" rel="noopener" class="btn-primary">{{ 'project.open_site'|trans }} ↗</a>
            {% endif %}
        </div>
        <div class="mt-5">
            <div class="mb-1 flex justify-between text-sm"><span class="font-medium">{{ 'project.progress'|trans }}</span><span>{{ project.progress }}%</span></div>
            <div class="progress h-3"><div class="progress-bar" style="width: {{ project.progress }}%"></div></div>
            <p class="mt-3 text-sm text-slate-600">{{ ('project.next_step.' ~ status.value|lower)|trans }}</p>
        </div>
    </div>

    {% if project.tasks is not empty %}
        <div class="card mt-6">
            <div class="card-header"><h2 class="card-title">{{ 'project.pipeline'|trans }}</h2></div>
            <ol class="card-body grid gap-3 sm:grid-cols-2 lg:grid-cols-7">
                {% for task in project.tasks %}
                    <li class="flex items-center gap-3 lg:flex-col lg:text-center">
                        <span class="stepper-dot {{ task.status.value == 'succeeded' ? 'bg-emerald-500 text-white' : (task.status.value == 'running' ? 'bg-brand-600 text-white animate-pulse' : (task.status.value in ['failed', 'waiting_admin'] ? 'bg-amber-500 text-white' : 'bg-slate-200 text-slate-600')) }}">
                            {{ task.status.value == 'succeeded' ? '✓' : loop.index }}
                        </span>
                        <span class="text-sm font-medium">{{ task.step.translationKey|trans }}</span>
                    </li>
                {% endfor %}
            </ol>
        </div>
    {% endif %}

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
            <div class="card">
                <div class="card-header"><h2 class="card-title">{{ 'project.details'|trans }}</h2></div>
                <dl class="card-body grid gap-4 text-sm sm:grid-cols-2">
                    <div><dt class="text-slate-500">{{ 'project.solution'|trans }}</dt><dd class="font-medium">{{ project.solution ? project.solution.name(app.request.locale) : '—' }}</dd></div>
                    <div><dt class="text-slate-500">{{ 'project.domain'|trans }}</dt><dd class="font-medium">{{ project.domainName ?: '—' }}</dd></div>
                    <div><dt class="text-slate-500">{{ 'project.website_url'|trans }}</dt><dd class="font-medium break-all">{% if project.deploymentUrl %}<a class="text-brand-700 hover:underline" href="{{ project.deploymentUrl }}" target="_blank" rel="noopener">{{ project.deploymentUrl }}</a>{% else %}—{% endif %}</dd></div>
                    <div><dt class="text-slate-500">{{ 'project.admin_url'|trans }}</dt><dd class="font-medium break-all">{% if project.adminUrl %}<a class="text-brand-700 hover:underline" href="{{ project.adminUrl }}" target="_blank" rel="noopener">{{ project.adminUrl }}</a>{% else %}—{% endif %}</dd></div>
                    <div><dt class="text-slate-500">{{ 'project.created_at'|trans }}</dt><dd class="font-medium">{{ project.createdAt|format_date('medium', locale: app.request.locale) }}</dd></div>
                    <div><dt class="text-slate-500">{{ 'project.delivered_at'|trans }}</dt><dd class="font-medium">{{ project.deliveredAt ? project.deliveredAt|format_date('medium', locale: app.request.locale) : '—' }}</dd></div>
                </dl>
                {% if project.features is not empty %}
                    <div class="border-t border-slate-100 px-5 py-4 sm:px-6">
                        <p class="mb-2 text-sm text-slate-500">{{ 'project.features'|trans }}</p>
                        <div class="flex flex-wrap gap-2">
                            {% for feature in project.features %}
                                {% set solution_feature = project.solution ? project.solution.feature(feature) : null %}
                                <span class="badge-brand">{{ solution_feature ? solution_feature.name(app.request.locale) : feature|replace({'_': ' '})|capitalize }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if project.credentials is not empty %}
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">{{ 'project.credentials'|trans }}</h2>
                        <span class="text-xs text-slate-500">🔒 {{ 'project.credentials_encrypted'|trans }}</span>
                    </div>
                    <ul class="divide-y divide-slate-100">
                        {% for credential in project.credentials %}
                            <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6">
                                <div class="text-sm">
                                    <p class="font-medium">{{ credential.label }}</p>
                                    <p class="text-slate-500">{{ 'project.username'|trans }}: <span class="font-mono text-ink">{{ credential.username }}</span></p>
                                    {% if credential.url %}<p class="text-slate-500 break-all">{{ credential.url }}</p>{% endif %}
                                </div>
                                {% if revealed is defined and revealed[credential.id] is defined %}
                                    <div class="flex items-center gap-2">
                                        <code class="rounded-lg bg-slate-100 px-3 py-1.5 font-mono text-sm">{{ revealed[credential.id] }}</code>
                                        <button type="button" class="btn-secondary btn-sm" data-copy="{{ revealed[credential.id] }}" data-copied-label="✓">{{ 'action.copy'|trans }}</button>
                                    </div>
                                {% else %}
                                    <form method="post" action="{{ path('account_credential_reveal', {reference: project.reference, id: credential.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reveal-credential-' ~ credential.id) }}">
                                        <button class="btn-secondary btn-sm">{{ 'project.reveal_password'|trans }}</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if project.deliveryDocumentation %}
                <div class="card">
                    <div class="card-header"><h2 class="card-title">{{ 'project.documentation'|trans }}</h2></div>
                    <div class="card-body"><pre class="whitespace-pre-wrap font-sans text-sm leading-relaxed text-slate-700">{{ project.deliveryDocumentation }}</pre></div>
                </div>
            {% endif %}
        </div>

        <aside class="card h-fit">
            <div class="card-header"><h2 class="card-title">{{ 'project.timeline'|trans }}</h2></div>
            <ol class="card-body space-y-4">
                {% for event in project.events|filter(e => e.type == 'transition')|slice(0, 20) %}
                    <li class="flex gap-3 text-sm">
                        <span class="mt-1.5 size-2 shrink-0 rounded-full bg-brand-500"></span>
                        <div>
                            <p class="font-medium">{{ event.toStatus ? event.toStatus.translationKey|trans : event.message }}</p>
                            <p class="text-xs text-slate-500">{{ event.createdAt|format_datetime('medium', 'short', locale: app.request.locale) }}</p>
                        </div>
                    </li>
                {% else %}
                    <li class="text-sm text-slate-500">{{ 'project.no_events'|trans }}</li>
                {% endfor %}
            </ol>
        </aside>
    </div>
</div>
{% endblock %}

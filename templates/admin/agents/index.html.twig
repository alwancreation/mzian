{% extends 'layouts/admin.html.twig' %}

{% block title %}Agents{% endblock %}
{% block page_title %}AI agents{% endblock %}

{% block admin_content %}
<p class="mb-6 max-w-3xl text-sm text-slate-600">Agents run the pipeline after a human approval, each with the minimum permissions of its job. Decisions such as {{ forbidden|slice(0, 5)|join(', ') }}… can never be granted to an agent. Budget rules: Admin &gt; Settings.</p>
<div class="grid gap-4 lg:grid-cols-2">
    {% for agent in agents %}
        <form method="post" action="{{ path('admin_agent_update', {id: agent.id}) }}" class="card card-body">
            <input type="hidden" name="_token" value="{{ csrf_token('agent-' ~ agent.id) }}">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 class="font-semibold">{{ agent.name }} <code class="text-xs text-slate-500">{{ agent.code }}</code></h2>
                    <p class="mt-1 text-sm text-slate-600">{{ agent.description }}</p>
                </div>
                <span class="{{ agent.enabled ? 'badge-green' : 'badge-gray' }}">{{ agent.enabled ? 'enabled' : 'disabled' }}</span>
            </div>
            <fieldset class="mt-3" {{ is_granted('ROLE_SUPER_ADMIN') ? '' : 'disabled' }}>
                <legend class="sr-only">Permissions of {{ agent.name }}</legend>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    {% for permission in permissions %}
                        <label class="form-check-label"><input type="checkbox" name="permissions[]" value="{{ permission }}" {{ agent.allowed(permission) ? 'checked' }}> <code class="text-xs">{{ permission }}</code></label>
                    {% endfor %}
                </div>
                <div class="mt-3 flex flex-wrap items-end gap-3">
                    <label class="form-check-label"><input type="checkbox" name="enabled" value="1" {{ agent.enabled ? 'checked' }}> Enabled</label>
                    <label class="text-sm">Max attempts <input type="number" name="max_attempts" min="1" max="10" value="{{ agent.maxAttempts }}" class="form-input w-20"></label>
                    {% if is_granted('ROLE_SUPER_ADMIN') %}<button class="btn-secondary btn-sm">Save</button>{% endif %}
                </div>
            </fieldset>
        </form>
    {% endfor %}
</div>

<h2 class="mb-3 mt-8 font-semibold">Recent activity</h2>
<div class="card table-wrap">
    <table class="table">
        <thead><tr><th>Run</th><th>Agent</th><th>Project</th><th>Attempt</th><th>Status</th><th>Duration</th><th>Started</th><th></th></tr></thead>
        <tbody>
        {% for run in runs %}
            <tr>
                <td class="font-mono text-xs">#{{ run.id }}</td>
                <td>{{ run.agentCode }}</td>
                <td>{% if run.project %}<a class="hover:text-brand-700" href="{{ path('admin_project', {id: run.project.id}) }}">{{ run.project.reference }}</a>{% endif %}</td>
                <td>{{ run.attempt }}</td>
                <td><span class="{{ run.status.badge }}">{{ run.status.value }}</span>{% if run.error %}<span class="block max-w-xs truncate text-xs text-slate-500" title="{{ run.error }}">{{ run.error }}</span>{% endif %}</td>
                <td class="text-xs">{{ run.durationMs is not null ? run.durationMs ~ ' ms' : '…' }}</td>
                <td class="text-xs text-slate-500">{{ run.startedAt|format_datetime('short', 'medium', locale: 'en') }}</td>
                <td class="text-end"><a class="btn-secondary btn-sm" href="{{ path('admin_agent_run', {id: run.id}) }}">Logs</a></td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="py-6 text-center text-slate-500">No agent run yet.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

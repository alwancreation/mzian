{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ lead.fullName ?: lead.email }}{% endblock %}
{% block page_title %}{{ lead.fullName ?: lead.email }} <span class="{{ lead.status.badge }} align-middle text-xs">{{ lead.status.value }}</span>{% endblock %}
{% block page_actions %}<a href="{{ path('admin_list', {section: 'leads'}) }}" class="btn-ghost btn-sm">← Leads</a>{% endblock %}

{% block admin_content %}
<div class="grid gap-6 xl:grid-cols-3">
    <div class="space-y-6 xl:col-span-2">
        <section class="card card-body text-sm">
            <h2 class="font-semibold">Contact</h2>
            <dl class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-2">
                <div><dt class="text-slate-500">E-mail</dt><dd>{{ lead.email }}</dd></div>
                <div><dt class="text-slate-500">Phone</dt><dd>{{ lead.phone|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Company</dt><dd>{{ lead.companyName|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Activity · city</dt><dd>{{ lead.sector|default('—') }} · {{ lead.city|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Language</dt><dd>{{ lead.locale }}</dd></div>
                <div><dt class="text-slate-500">Marketing consent</dt><dd>{{ lead.marketingConsent ? 'yes' : 'no' }}</dd></div>
                <div><dt class="text-slate-500">Customer account</dt><dd>{{ lead.customer ? lead.customer.displayName : '—' }}</dd></div>
                <div><dt class="text-slate-500">Since</dt><dd>{{ lead.createdAt|format_datetime('medium', 'short', locale: 'en') }}</dd></div>
            </dl>
        </section>

        <section class="card card-body text-sm">
            <h2 class="font-semibold">Requirements & projects</h2>
            <ul class="mt-3 divide-y divide-slate-100">
                {% for requirement in requirements %}
                    <li class="py-2">
                        <span class="{{ badge_class(requirement.status) }}">{{ requirement.status.value }}</span>
                        {{ requirement.businessName|default(requirement.sector|default('—')) }}
                        {% if requirement.recommendedSolution %}→ <strong>{{ requirement.recommendedSolution.name('en') }}</strong>{% endif %}
                        <span class="text-xs text-slate-500">{{ requirement.analyzedAt ? 'analyzed ' ~ requirement.analyzedAt|format_datetime('short', 'short', locale: 'en') : 'not analyzed' }}</span>
                    </li>
                {% else %}
                    <li class="py-2 text-slate-500">No requirement yet.</li>
                {% endfor %}
            </ul>
            {% if projects is not empty %}
                <ul class="mt-3 space-y-1">
                    {% for project in projects %}
                        <li><a href="{{ path('admin_project', {id: project.id}) }}" class="font-mono text-brand-700 hover:underline">{{ project.reference }}</a> {{ project.name }} <span class="{{ project.status.badge }}">{{ project.status.value }}</span></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="card card-body text-sm">
            <h2 class="font-semibold">Activity</h2>
            <ol class="mt-3 space-y-2" data-testid="lead-activity">
                {% for activity in lead.activities|reverse %}
                    <li class="flex gap-3">
                        <span class="w-36 shrink-0 text-xs text-slate-500">{{ activity.createdAt|format_datetime('short', 'short', locale: 'en') }}</span>
                        <span><code class="text-xs">{{ activity.type }}</code> {{ activity.description }}</span>
                    </li>
                {% else %}
                    <li class="text-slate-500">No activity.</li>
                {% endfor %}
            </ol>
            <form method="post" action="{{ path('admin_lead_activity', {id: lead.id}) }}" class="mt-4 space-y-2">
                <input type="hidden" name="_token" value="{{ csrf_token('lead-' ~ lead.id) }}">
                <label class="form-label" for="lead-note">Note (call, e-mail, meeting...)</label>
                <textarea id="lead-note" name="note" rows="2" class="form-textarea" required maxlength="2000"></textarea>
                <div class="flex flex-wrap items-center gap-3">
                    <button class="btn-secondary btn-sm">Add note</button>
                    {% if lead.status.value not in ['converted', 'lost'] %}<label class="form-check-label"><input type="checkbox" name="lost" value="1"> Mark as lost</label>{% endif %}
                </div>
            </form>
        </section>
    </div>

    <aside class="space-y-6">
        <section class="card card-body text-sm">
            <h2 class="font-semibold">Attribution</h2>
            <dl class="mt-3 space-y-2 break-all">
                <div><dt class="text-slate-500">Source</dt><dd><span class="badge-blue">{{ lead.source.value }}</span></dd></div>
                {% for key, value in lead.utm %}<div><dt class="text-slate-500">{{ key }}</dt><dd>{{ value }}</dd></div>{% endfor %}
                <div><dt class="text-slate-500">Referrer</dt><dd>{{ lead.referrer|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Landing page</dt><dd>{{ lead.landingPage|default('—') }}</dd></div>
            </dl>
        </section>
    </aside>
</div>
{% endblock %}

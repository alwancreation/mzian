{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}
{% block page_title %}{{ project.name }} <span class="font-mono text-sm font-normal text-slate-500">{{ project.reference }}</span>{% endblock %}
{% block page_actions %}<a href="{{ path('admin_approvals') }}" class="btn-ghost btn-sm">← Approvals</a>{% endblock %}

{% block admin_content %}
{% set status = project.status %}
{% set token = csrf_token('project-' ~ project.id) %}
{% set currency = quote ? quote.currency : project.currency %}
<div class="mb-6 flex flex-wrap items-center gap-2">
    <span class="{{ status.badge }}" data-testid="project-status">{{ status.value }}</span>
    <span class="{{ project.risk == 'high' ? 'badge-red' : (project.risk == 'medium' ? 'badge-amber' : 'badge-green') }}">risk: {{ project.risk }}</span>
    {% if project.simulated %}<span class="badge-amber" title="Mock providers: nothing real is bought or deployed">simulated</span>{% endif %}
    {% if project.automationPaused %}<span class="badge-gray">automation paused</span>{% endif %}
    {% if project.approvedBy %}<span class="text-xs text-slate-500">approved by {{ project.approvedBy.fullName }} on {{ project.approvedAt|format_datetime('medium', 'short', locale: 'en') }}</span>{% endif %}
</div>

<div class="grid gap-6 xl:grid-cols-3">
    <div class="space-y-6 xl:col-span-2">
        {# ------------------------------------------------------------ Decision #}
        {% if status.value == 'PENDING_ADMIN_APPROVAL' %}
            <section class="card card-body border-2 border-brand-200" aria-labelledby="decision">
                <h2 id="decision" class="font-semibold">Decision required</h2>
                <p class="mt-1 text-sm text-slate-600">Check the request, the costs and the risks. Approving starts the agents within the automation budget ({{ project.budget|money(currency) }}).</p>
                <div class="mt-4 grid gap-4 lg:grid-cols-3">
                    <form method="post" action="{{ path('admin_project_action', {id: project.id, action: 'approve'}) }}" class="space-y-2">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label class="form-label" for="approve-note">Internal note (optional)</label>
                        <textarea id="approve-note" name="message" rows="3" class="form-textarea"></textarea>
                        <button class="btn-success w-full">✅ Approve</button>
                    </form>
                    <form method="post" action="{{ path('admin_project_action', {id: project.id, action: 'request_changes'}) }}" class="space-y-2">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label class="form-label" for="changes-message">Question for the customer</label>
                        <textarea id="changes-message" name="message" rows="3" class="form-textarea" required></textarea>
                        <button class="btn-warning w-full">✏️ Request changes</button>
                    </form>
                    <form method="post" action="{{ path('admin_project_action', {id: project.id, action: 'reject'}) }}" class="space-y-2" data-confirm="Reject this project and notify the customer?">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label class="form-label" for="reject-reason">Reason (sent to the customer)</label>
                        <textarea id="reject-reason" name="message" rows="3" class="form-textarea" required></textarea>
                        <label class="form-check text-sm"><input type="checkbox" name="refund" value="1" checked> Refund the payment</label>
                        <button class="btn-danger w-full">⛔ Reject</button>
                    </form>
                </div>
            </section>
        {% elseif status.value == 'CHANGES_REQUESTED' %}
            <section class="card card-body border-2 border-amber-200">
                <h2 class="font-semibold">Waiting for the customer</h2>
                <p class="mt-2 whitespace-pre-line text-sm text-slate-700">{{ project.changesRequested }}</p>
            </section>
        {% elseif status.value in ['WAITING_ADMIN_APPROVAL', 'FAILED'] %}
            {% set resume_action = status.value == 'FAILED' ? 'retry' : 'resume' %}
            <section class="card card-body border-2 {{ status.value == 'FAILED' ? 'border-red-200' : 'border-amber-200' }}">
                <h2 class="font-semibold">{{ status.value == 'FAILED' ? 'Automation failed' : 'Agent waiting for an administrator' }}</h2>
                <p class="mt-2 text-sm text-slate-700">{{ project.holdReason ?? '—' }}</p>
                <form method="post" action="{{ path('admin_project_action', {id: project.id, action: resume_action}) }}" class="mt-4 flex flex-wrap items-end gap-3">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div>
                        <label class="form-label" for="resume-at">{{ resume_action|capitalize }} at</label>
                        <select id="resume-at" name="at" class="form-select">
                            {% for state in automation_states %}<option value="{{ state.value }}" {{ project.resumeStatus == state ? 'selected' }}>{{ state.value }}</option>{% endfor %}
                        </select>
                    </div>
                    <button class="btn-primary">▶️ {{ resume_action|capitalize }}</button>
                </form>
            </section>
        {% endif %}

        {# ------------------------------------------------------------ Request #}
        <section class="card card-body">
            <h2 class="font-semibold">Customer & business</h2>
            <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
                <div><dt class="text-slate-500">Customer</dt><dd class="font-medium">{{ project.customer ? project.customer.displayName ~ ' <' ~ project.customer.email ~ '>' : (project.lead ? project.lead.fullName ~ ' <' ~ project.lead.email ~ '> (lead)' : '—') }}</dd></div>
                <div><dt class="text-slate-500">Phone</dt><dd>{{ project.customer ? project.customer.phone|default('—') : (project.lead ? project.lead.phone|default('—') : '—') }}</dd></div>
                <div><dt class="text-slate-500">Business</dt><dd class="font-medium">{{ project.businessName|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Activity</dt><dd>{{ sector ? sector.icon ~ ' ' ~ sector.name('en') : project.sector|default('—') }} · {{ requirement.city|default('—') }}</dd></div>
                <div><dt class="text-slate-500">Lead source</dt><dd>{{ project.lead ? project.lead.source.value : '—' }}</dd></div>
                <div><dt class="text-slate-500">Domain</dt><dd class="font-mono">{{ project.domainName|default('—') }}</dd></div>
            </dl>
            {% if requirement.description %}<p class="mt-4 whitespace-pre-line rounded-xl bg-slate-50 p-3 text-sm">{{ requirement.description }}</p>{% endif %}
            {% if requirement.items is not empty %}
                <details class="mt-4">
                    <summary class="cursor-pointer text-sm font-semibold">Answers ({{ requirement.items|length }})</summary>
                    <dl class="mt-3 divide-y divide-slate-100 text-sm">
                        {% for item in requirement.items %}
                            <div class="grid gap-2 py-2 sm:grid-cols-2"><dt class="text-slate-500">{{ item.label }}</dt><dd>{{ item.value is iterable ? item.value|join(', ') : (item.value is same as(true) ? 'yes' : (item.value is same as(false) ? 'no' : item.value)) }} <span class="text-xs text-slate-400">{{ item.source.value }}</span></dd></div>
                        {% endfor %}
                    </dl>
                </details>
            {% endif %}
            {% if transcript is not empty %}
                <details class="mt-3">
                    <summary class="cursor-pointer text-sm font-semibold">AI conversation ({{ transcript|length }} messages)</summary>
                    <ol class="mt-3 space-y-2 text-sm">
                        {% for message in transcript %}<li class="{{ message.role == 'user' ? 'bg-brand-50' : 'bg-slate-50' }} rounded-lg p-2"><span class="text-xs font-semibold uppercase text-slate-500">{{ message.role }}</span><p class="whitespace-pre-line">{{ message.content }}</p></li>{% endfor %}
                    </ol>
                </details>
            {% endif %}
        </section>

        {# ------------------------------------------------------------ Solution & analysis #}
        <section class="card card-body">
            <h2 class="font-semibold">Recommended solution</h2>
            {% if solution %}
                <p class="mt-2 text-lg font-semibold">{{ solution.icon }} {{ solution.name('en') }} <span class="text-sm font-normal text-slate-500">template {{ project.applicationTemplate }}, {{ project.complexity }} complexity, {{ project.estimatedDevelopmentDays }} days</span></p>
                <ul class="mt-3 grid gap-1 text-sm sm:grid-cols-2">
                    {% for code in project.features %}
                        {% set feature = solution.feature(code) %}
                        <li>✓ {{ feature ? feature.name('en') : code }}{% if feature and not feature.included %} <span class="badge-blue">option</span>{% elseif not feature %} <span class="badge-amber">no template</span>{% endif %}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if analysis %}
                <div class="mt-4 rounded-xl bg-slate-50 p-4 text-sm">
                    <p class="font-semibold">AI analysis <span class="font-normal text-slate-500">— {{ analysis.engine }}, confidence {{ (analysis.confidence * 100)|round }} %{% if analysis.fallback_used %}, <span class="text-amber-700">fallback: {{ analysis.fallback_reason }}</span>{% endif %}</span></p>
                    <p class="mt-2">{{ analysis.recommendation }}</p>
                    {% if analysis.unsupported_features is not empty %}<p class="mt-2 text-amber-800">Custom development: {{ analysis.unsupported_features|join(', ') }}</p>{% endif %}
                    {% if analysis.usage.model is defined %}<p class="mt-2 text-xs text-slate-500">AI usage: {{ analysis.usage.model }}, {{ analysis.usage.input_tokens|default(0) }} + {{ analysis.usage.output_tokens|default(0) }} tokens, {{ (analysis.usage.cost_cents|default(0))|round|money(currency) }}{{ analysis.usage.simulated|default(false) ? ' (simulated)' }}</p>{% endif %}
                </div>
            {% endif %}
            {% if project.riskNotes is not empty %}
                <div class="mt-4">
                    <p class="text-sm font-semibold">Risks</p>
                    <ul class="mt-2 list-inside list-disc text-sm text-slate-700">{% for note in project.riskNotes %}<li>{{ note }}</li>{% endfor %}</ul>
                </div>
            {% endif %}
        </section>

        {# ------------------------------------------------------------ Timeline #}
        <section class="card card-body">
            <h2 class="font-semibold">Timeline</h2>
            <ol class="mt-4 space-y-3 text-sm" data-testid="timeline">
                {% for event in project.events %}
                    <li class="flex gap-3">
                        <span class="w-36 shrink-0 text-xs text-slate-500">{{ event.createdAt|format_datetime('short', 'medium', locale: 'en') }}</span>
                        <span>
                            {% if event.transition %}<code class="text-xs">{{ event.fromStatus ? event.fromStatus.value : '' }} → {{ event.toStatus ? event.toStatus.value : '' }}</code>{% endif %}
                            <span class="block">{{ event.message }}</span>
                            <span class="text-xs text-slate-500">{{ event.actorType.value }}: {{ event.actorName }}</span>
                        </span>
                    </li>
                {% else %}
                    <li class="text-slate-500">No event yet.</li>
                {% endfor %}
            </ol>
        </section>
    </div>

    <aside class="space-y-6">
        {# ------------------------------------------------------------ Money #}
        {% if quote %}
            <section class="card card-body text-sm">
                <h2 class="font-semibold">Costs & margin <span class="font-normal text-slate-500">{{ quote.number }}</span></h2>
                <table class="mt-3 w-full">
                    <thead><tr class="text-xs text-slate-500"><th class="text-start font-normal">Line</th><th class="text-end font-normal">Cost</th><th class="text-end font-normal">Price</th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for item in quote.items %}
                            <tr class="{{ item.customerVisible ? '' : 'text-slate-500' }}"><td class="py-1.5 pe-2">{{ item.label }}{% if item.recurring %} <span class="badge-blue">/month</span>{% endif %}</td><td class="whitespace-nowrap py-1.5 ps-3 text-end">{{ item.cost|money(quote.currency) }}</td><td class="whitespace-nowrap py-1.5 ps-3 text-end">{{ item.price|money(quote.currency) }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
                <dl class="mt-4 space-y-1.5 border-t border-slate-200 pt-3" data-testid="money">
                    <div class="flex justify-between"><dt>Total cost</dt><dd>{{ quote.costPrice|money(quote.currency) }}</dd></div>
                    <div class="flex justify-between font-semibold"><dt>Selling price</dt><dd>{{ quote.sellingPrice|money(quote.currency) }}</dd></div>
                    <div class="flex justify-between text-emerald-700"><dt>Margin</dt><dd>{{ quote.margin|money(quote.currency) }} ({{ quote.marginPercentage|number_format(1) }} %)</dd></div>
                    <div class="flex justify-between"><dt>Recurring</dt><dd>{{ quote.recurringMonthly|money(quote.currency) }} / month</dd></div>
                    <div class="flex justify-between"><dt>Automation budget</dt><dd>{{ project.budget|money(quote.currency) }}</dd></div>
                    <div class="flex justify-between"><dt>Spent so far</dt><dd>{{ project.spent|money(quote.currency) }}</dd></div>
                </dl>
            </section>
        {% endif %}

        {# ------------------------------------------------------------ Payments #}
        <section id="payments" class="card card-body text-sm">
            <h2 class="font-semibold">Order & payments</h2>
            {% if order %}
                <p class="mt-2"><span class="font-mono">{{ order.number }}</span> <span class="{{ order.status.badge }}">{{ order.status.value }}</span></p>
                <ul class="mt-3 space-y-3">
                    {% for payment in payments %}
                        <li class="rounded-lg border border-slate-200 p-3">
                            <div class="flex justify-between gap-2"><span>{{ payment.provider }} · {{ payment.amount|money(payment.currency) }}</span><span class="{{ payment.status.badge }}">{{ payment.status.value }}</span></div>
                            <p class="text-xs text-slate-500">{{ payment.idempotencyKey }}{% if payment.failureReason %} — {{ payment.failureReason }}{% endif %}</p>
                            {% if payment.status.value == 'pending' and payment.metadata.offline|default(false) %}
                                <form method="post" action="{{ path('admin_payment_confirm', {id: payment.id}) }}" class="mt-2 space-y-2" data-confirm="Confirm that the transfer has been received on the bank account?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('payment-confirm-' ~ payment.id) }}">
                                    <input type="text" name="note" class="form-input" placeholder="Bank reference / note">
                                    <button class="btn-success btn-sm w-full">Confirm transfer received</button>
                                </form>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="text-slate-500">No payment yet.</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="mt-2 text-slate-500">Not ordered yet.</p>
            {% endif %}
        </section>

        {# ------------------------------------------------------------ Controls #}
        {% if not status.terminal and (status.automation or status.value not in ['PENDING_ADMIN_APPROVAL', 'CHANGES_REQUESTED']) %}
            <section class="card card-body text-sm">
                <h2 class="font-semibold">Controls</h2>
                {% if status.automation %}
                    <form method="post" action="{{ path('admin_project_action', {id: project.id, action: project.automationPaused ? 'unpause' : 'pause'}) }}" class="mt-3">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button class="btn-secondary w-full">{{ project.automationPaused ? '▶️ Unpause automation' : '⏸️ Pause automation' }}</button>
                    </form>
                {% endif %}
                {% if status.value not in ['PENDING_ADMIN_APPROVAL', 'CHANGES_REQUESTED'] %}
                    <form method="post" action="{{ path('admin_project_action', {id: project.id, action: 'cancel'}) }}" class="mt-3 space-y-2" data-confirm="Cancel this project?">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <textarea name="message" rows="2" class="form-textarea" placeholder="Reason" required></textarea>
                        {% if order and order.paid %}<label class="form-check"><input type="checkbox" name="refund" value="1"> Refund the payment</label>{% endif %}
                        <button class="btn-danger w-full">Cancel project</button>
                    </form>
                {% endif %}
            </section>
        {% endif %}
        {% if project.rejectionReason %}
            <section class="card card-body text-sm"><h2 class="font-semibold">Reason</h2><p class="mt-2 whitespace-pre-line">{{ project.rejectionReason }}</p></section>
        {% endif %}
    </aside>
</div>
{% endblock %}

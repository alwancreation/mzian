<a href="{{ path('solution_show', {slug: solution.slug(app.request.locale)}) }}" class="card card-body card-hover flex flex-col">
    <div class="flex items-start justify-between gap-3">
        <span class="flex size-12 items-center justify-center rounded-2xl bg-brand-50 text-2xl">{{ solution.icon }}</span>
        {% if solution.featured %}<span class="badge-brand">{{ 'catalog.popular'|trans }}</span>{% endif %}
    </div>
    <h3 class="mt-4 text-lg font-semibold">{{ solution.name(app.request.locale) }}</h3>
    <p class="mt-1 flex-1 text-sm text-slate-600">{{ solution.shortDescription(app.request.locale) }}</p>
    <ul class="mt-4 space-y-1 text-sm text-slate-600">
        {% for feature in solution.enabledFeatures|filter(f => f.included)|slice(0, 4) %}
            <li class="flex gap-2"><span class="text-accent-600">✓</span>{{ feature.name(app.request.locale) }}</li>
        {% endfor %}
    </ul>
    {% if starting_prices is defined and starting_prices[solution.code] is defined %}
        <p class="mt-4 text-sm text-slate-500">{{ 'catalog.from'|trans }} <span class="text-xl font-bold text-ink">{{ starting_prices[solution.code]|money(currency|default(null), false) }}</span></p>
    {% endif %}
    <span class="mt-4 text-sm font-semibold text-brand-700">{{ 'catalog.discover'|trans }} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span></span>
</a>

{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'catalog.industries.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'catalog.industries.lead'|trans }}{% endblock %}

{% block content %}
{% include 'components/_page_header.html.twig' with {eyebrow: 'nav.industries'|trans, title: 'catalog.industries.title'|trans, lead: 'catalog.industries.lead'|trans} %}
<section class="section">
    <div class="container-page grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for sector in sectors %}
            <a href="{{ path('industry_show', {slug: sector.slug(app.request.locale)}) }}" class="card card-body card-hover">
                <span class="text-3xl">{{ sector.icon }}</span>
                <h2 class="mt-3 text-lg font-semibold">{{ sector.name(app.request.locale) }}</h2>
                <p class="mt-1 text-sm text-slate-600">{{ sector.description(app.request.locale) }}</p>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}

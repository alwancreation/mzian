{% extends 'layouts/public.html.twig' %}

{% set locale = app.request.locale %}
{% set alternate_overrides = {fr: {slug: solution.slug('fr')}, en: {slug: solution.slug('en')}, ar: {slug: solution.slug('ar')}} %}

{% block title %}{{ solution.name(locale) }}{% endblock %}
{% block meta_description %}{{ solution.shortDescription(locale) }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{{ [
    {
        '@context': 'https://schema.org',
        '@type': 'Service',
        'name': solution.name(locale),
        'description': solution.description(locale),
        'provider': {'@type': 'Organization', 'name': 'Mzian.net', 'url': url('home')},
        'areaServed': 'MA',
        'serviceType': solution.category.value,
        'url': url('solution_show', {slug: solution.slug(locale)})
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            {'@type': 'ListItem', 'position': 1, 'name': 'Mzian.net', 'item': url('home')},
            {'@type': 'ListItem', 'position': 2, 'name': 'nav.solutions'|trans, 'item': url('solutions_index')},
            {'@type': 'ListItem', 'position': 3, 'name': solution.name(locale), 'item': url('solution_show', {slug: solution.slug(locale)})}
        ]
    }
]|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
</script>
{% endblock %}

{% block content %}
<section class="relative overflow-hidden border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="container-page relative grid gap-10 py-14 lg:grid-cols-5 lg:py-20">
        <div class="lg:col-span-3">
            <nav class="text-sm text-slate-500" aria-label="Breadcrumb"><a class="hover:text-brand-700" href="{{ path('solutions_index') }}">{{ 'nav.solutions'|trans }}</a> / {{ solution.name(locale) }}</nav>
            <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{{ solution.icon }} {{ solution.name(locale) }}</h1>
            <p class="mt-4 text-lg text-slate-600">{{ solution.description(locale) }}</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="{{ path('start', {sector: solution.sectors|first|default('')}) }}" class="btn-primary btn-lg btn-glow">{{ 'catalog.get_proposal'|trans }}</a>
                <a href="{{ path('how_it_works') }}" class="btn-secondary btn-lg">{{ 'nav.how_it_works'|trans }}</a>
            </div>
        </div>
        <aside class="card card-body h-fit lg:col-span-2">
            <dl class="space-y-3 text-sm">
                {% if starting_price is defined and starting_price %}
                    <div class="flex justify-between gap-3"><dt class="text-slate-500">{{ 'catalog.from'|trans }}</dt><dd class="text-2xl font-bold">{{ starting_price|money(currency|default(null), false) }}</dd></div>
                {% endif %}
                <div class="flex justify-between gap-3"><dt class="text-slate-500">{{ 'catalog.delivery_time'|trans }}</dt><dd class="font-semibold">{{ 'catalog.days'|trans({'%count%': solution.estimatedDevelopmentDays}) }}</dd></div>
                {% if solution.maintenancePrice > 0 %}
                    <div class="flex justify-between gap-3"><dt class="text-slate-500">{{ 'catalog.maintenance'|trans }}</dt><dd class="font-semibold">{{ solution.maintenancePrice|money(currency|default(null)) }} / {{ 'pricing.month'|trans }}</dd></div>
                {% endif %}
                <div class="flex justify-between gap-3"><dt class="text-slate-500">{{ 'catalog.included'|trans }}</dt><dd class="text-end font-semibold">{{ 'catalog.included_value'|trans }}</dd></div>
            </dl>
        </aside>
    </div>
</section>

<section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
        <div>
            <h2 class="section-title text-2xl">{{ 'catalog.included_features'|trans }}</h2>
            <ul class="mt-6 grid gap-3">
                {% for feature in solution.enabledFeatures|filter(f => f.included) %}
                    <li class="card card-body flex items-center gap-3 py-4"><span class="text-accent-600">✓</span><span class="font-medium">{{ feature.name(locale) }}</span></li>
                {% endfor %}
            </ul>
        </div>
        <div>
            <h2 class="section-title text-2xl">{{ 'catalog.options'|trans }}</h2>
            <ul class="mt-6 grid gap-3">
                {% for feature in solution.enabledFeatures|filter(f => not f.included) %}
                    <li class="card card-body flex items-center justify-between gap-3 py-4"><span class="font-medium">＋ {{ feature.name(locale) }}</span><span class="text-sm text-slate-500">{{ 'catalog.on_request'|trans }}</span></li>
                {% else %}
                    <li class="text-sm text-slate-500">{{ 'catalog.no_options'|trans }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>

{% if sectors is not empty or related is not empty %}
<section class="section bg-slate-50">
    <div class="container-page">
        {% if sectors is not empty %}
            <h2 class="text-xl font-semibold">{{ 'catalog.for_sectors'|trans }}</h2>
            <div class="mt-4 flex flex-wrap gap-2">
                {% for sector in sectors %}<a href="{{ path('industry_show', {slug: sector.slug(locale)}) }}" class="badge-gray px-3 py-1 text-sm hover:bg-white">{{ sector.icon }} {{ sector.name(locale) }}</a>{% endfor %}
            </div>
        {% endif %}
        {% if related is not empty %}
            <h2 class="mt-10 text-xl font-semibold">{{ 'catalog.related'|trans }}</h2>
            <div class="mt-4 grid gap-6 md:grid-cols-3">
                {% for solution in related %}{% include 'catalog/_solution_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
{% endblock %}

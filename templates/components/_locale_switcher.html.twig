{% set labels = {fr: 'FR', en: 'EN', ar: 'ع'} %}
{% set names = {fr: 'Français', en: 'English', ar: 'العربية'} %}
<div class="relative">
    <button type="button" class="btn-ghost btn-sm" data-toggle="locale-menu-{{ variant|default('a') }}" aria-expanded="false" aria-label="{{ 'nav.language'|trans }}">
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
        {{ labels[app.request.locale]|default('FR') }}
    </button>
    <div id="locale-menu-{{ variant|default('a') }}" class="hidden absolute end-0 z-50 mt-2 w-40 rounded-xl bg-white p-1 shadow-lg ring-1 ring-slate-200">
        {% for loc, url in locale_urls(alternate_overrides|default({})) %}
            <a href="{{ url }}" hreflang="{{ loc }}" lang="{{ loc }}" class="block rounded-lg px-3 py-2 text-sm hover:bg-slate-50 {{ loc == app.request.locale ? 'font-semibold text-brand-700' : 'text-slate-700' }}">{{ names[loc] }}</a>
        {% endfor %}
    </div>
</div>

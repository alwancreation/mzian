<section class="relative overflow-hidden border-b border-slate-100 bg-gradient-to-b from-brand-50/70 to-white">
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="container-page relative py-14 sm:py-20">
        {% if eyebrow is defined %}<p class="text-sm font-semibold text-brand-600">{{ eyebrow }}</p>{% endif %}
        <h1 class="mt-2 max-w-3xl text-4xl font-bold sm:text-5xl">{{ title }}</h1>
        {% if lead is defined %}<p class="mt-4 max-w-2xl text-lg text-slate-600">{{ lead }}</p>{% endif %}
    </div>
</section>

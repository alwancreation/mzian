{# Subscription plans grid. Expects: plans, locale. #}
<div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
    {% for plan in plans %}
        <div class="card card-body {{ plan.recommended ? 'ring-2 ring-brand-500' : '' }}">
            {% if plan.recommended %}<span class="badge-brand mb-3">{{ 'catalog.popular'|trans }}</span>{% endif %}
            <h3 class="text-lg font-semibold">{{ plan.name(locale) }}</h3>
            <p class="mt-1 text-sm text-slate-600">{{ plan.description(locale) }}</p>
            <p class="mt-4"><span class="text-3xl font-bold">{{ plan.price|money(null, false) }}</span> <span class="text-slate-500">/ {{ ('pricing.' ~ plan.interval.value)|trans }}</span></p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
                {% for feature in plan.features(locale) %}<li class="flex gap-2"><span class="text-accent-600">✓</span>{{ feature }}</li>{% endfor %}
            </ul>
        </div>
    {% endfor %}
</div>

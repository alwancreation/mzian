{% extends 'base.html.twig' %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block seo_links %}{% endblock %}
{% block body_class %}min-h-full bg-canvas{% endblock %}

{% block body %}
{% set route = app.request.attributes.get('_route') %}
{% set section = app.request.attributes.get('section') %}
<div class="min-h-screen lg:flex">
    <aside id="admin-sidebar" class="hidden w-full shrink-0 bg-slate-950 text-slate-200 lg:sticky lg:top-0 lg:block lg:h-screen lg:w-64 lg:overflow-y-auto">
        <div class="flex h-16 items-center px-5">
            <a href="{{ path('admin_dashboard') }}">{% include 'components/_logo.html.twig' with {class: 'text-white', variant: 'admin'} %}</a>
        </div>
        <nav class="space-y-6 px-3 pb-8" aria-label="Admin">
            {% for group in admin_menu() %}
                <div>
                    <p class="px-3 pb-2 text-[11px] font-semibold tracking-wider text-slate-500 uppercase">{{ group.label }}</p>
                    {% for item in group.items %}
                        {% set active = route == item.route and (item.params.section|default(null) == section) or (route starts with item.route ~ '_' and item.params is empty) %}
                        <a href="{{ path(item.route, item.params) }}" class="{{ active ? 'sidebar-link-active' : 'sidebar-link' }}">
                            <span aria-hidden="true">{{ item.icon }}</span>{{ item.label }}
                        </a>
                    {% endfor %}
                </div>
            {% endfor %}
        </nav>
    </aside>
    <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-30 flex h-16 items-center justify-between gap-4 border-b border-slate-200 bg-white/90 px-4 backdrop-blur sm:px-6">
            <div class="flex items-center gap-3">
                <button type="button" class="btn-ghost btn-sm lg:hidden" data-toggle="admin-sidebar" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Menu">☰</button>
                <h1 class="truncate text-lg font-semibold">{% block page_title %}{% endblock %}</h1>
            </div>
            <div class="flex items-center gap-3 text-sm">
                {% block page_actions %}{% endblock %}
                <span class="hidden text-slate-500 sm:inline">{{ app.user.fullName }}</span>
                {% if is_granted('ROLE_SUPER_ADMIN') %}<span class="badge-violet hidden sm:inline-flex">super admin</span>{% endif %}
                <a href="{{ logout_path('main') }}" class="btn-ghost btn-sm">Logout</a>
            </div>
        </header>
        <main class="p-4 sm:p-6 lg:p-8">
            {% include 'components/_flashes.html.twig' %}
            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}

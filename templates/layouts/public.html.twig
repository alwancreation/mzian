{% extends 'base.html.twig' %}

{% block body_class %}min-h-full flex flex-col bg-white{% endblock %}

{% block body %}
{% set route = app.request.attributes.get('_canonical_route') ?? app.request.attributes.get('_route') %}
{% set nav_items = [
    {route: 'how_it_works', label: 'nav.how_it_works'},
    {route: 'faq', label: 'nav.faq'},
    {route: 'contact', label: 'nav.contact'},
] %}
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 btn-primary">{{ 'nav.skip_to_content'|trans }}</a>
<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/85 backdrop-blur">
    <div class="container-page flex h-16 items-center justify-between gap-4">
        <a href="{{ path('home') }}" aria-label="Mzian.net">{% include 'components/_logo.html.twig' %}</a>
        <nav class="hidden items-center gap-1 lg:flex" aria-label="{{ 'nav.main'|trans }}">
            {% for item in nav_items %}
                <a href="{{ path(item.route) }}" class="{{ route == item.route ? 'nav-link-active' : 'nav-link' }}">{{ item.label|trans }}</a>
            {% endfor %}
        </nav>
        <div class="flex items-center gap-2">
            {% include 'components/_locale_switcher.html.twig' %}
            {% if app.user %}
                <a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'account_dashboard') }}" class="btn-secondary hidden sm:inline-flex">{{ 'nav.my_account'|trans }}</a>
            {% else %}
                <a href="{{ path('login') }}" class="nav-link hidden sm:inline-flex">{{ 'nav.login'|trans }}</a>
            {% endif %}
            <a href="{{ path('register') }}" class="btn-primary hidden sm:inline-flex">{{ 'cta.start_free'|trans }}</a>
            <button type="button" class="btn-ghost lg:hidden" data-toggle="mobile-menu" aria-controls="mobile-menu" aria-expanded="false" aria-label="{{ 'nav.menu'|trans }}">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
        </div>
    </div>
    <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white lg:hidden">
        <nav class="container-page flex flex-col gap-1 py-3">
            {% for item in nav_items %}
                <a href="{{ path(item.route) }}" class="nav-link">{{ item.label|trans }}</a>
            {% endfor %}
            {% if app.user %}
                <a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'account_dashboard') }}" class="nav-link">{{ 'nav.my_account'|trans }}</a>
            {% else %}
                <a href="{{ path('login') }}" class="nav-link">{{ 'nav.login'|trans }}</a>
            {% endif %}
            <a href="{{ path('register') }}" class="btn-primary mt-2">{{ 'cta.start_free'|trans }}</a>
        </nav>
    </div>
</header>

<main id="main" class="flex-1">
    {% if app.flashes|length > 0 %}
        <div class="container-page pt-6">{% include 'components/_flashes.html.twig' %}</div>
    {% endif %}
    {% block content %}{% endblock %}
</main>

<footer class="border-t border-slate-100 bg-slate-50">
    <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div class="space-y-3">
            {% include 'components/_logo.html.twig' with {variant: 'footer'} %}
            <p class="text-sm text-slate-600">{{ 'footer.tagline'|trans }}</p>
        </div>
        <div>
            <p class="text-sm font-semibold">{{ 'footer.product'|trans }}</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand-700" href="{{ path('how_it_works') }}">{{ 'nav.how_it_works'|trans }}</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm font-semibold">{{ 'footer.company'|trans }}</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand-700" href="{{ path('how_it_works') }}">{{ 'nav.how_it_works'|trans }}</a></li>
                <li><a class="hover:text-brand-700" href="{{ path('faq') }}">{{ 'nav.faq'|trans }}</a></li>
                <li><a class="hover:text-brand-700" href="{{ path('contact') }}">{{ 'nav.contact'|trans }}</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm font-semibold">{{ 'footer.legal'|trans }}</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <li><a class="hover:text-brand-700" href="{{ path('legal_terms') }}">{{ 'footer.terms'|trans }}</a></li>
                <li><a class="hover:text-brand-700" href="{{ path('legal_privacy') }}">{{ 'footer.privacy'|trans }}</a></li>
            </ul>
        </div>
    </div>
    <div class="border-t border-slate-200/70">
        <div class="container-page flex flex-col gap-2 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <p>© {{ 'now'|date('Y') }} Mzian.net — {{ 'footer.rights'|trans }}</p>
            <p>{{ 'footer.made_with_ai'|trans }}</p>
        </div>
    </div>
</footer>
{% endblock %}

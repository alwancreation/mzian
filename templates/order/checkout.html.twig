{% extends 'layouts/public.html.twig' %}

{% set locale = app.request.locale %}
{% block title %}{{ 'checkout.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{% block seo_links %}{% endblock %}

{% block content %}
<section class="bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page max-w-5xl py-8 sm:py-12">
        {% include 'start/_steps.html.twig' with {current: 'proposal'} %}
        <h1 class="text-3xl font-bold">{{ 'checkout.title'|trans }}</h1>
        <p class="mt-1 text-slate-600">{{ 'checkout.lead'|trans }}</p>

        {% for error in errors %}<div class="alert-error mt-4" role="alert"><span>{{ error|trans }}</span></div>{% endfor %}

        <form method="post" class="mt-6 grid gap-6 lg:grid-cols-5">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout-' ~ quote.token) }}">
            <div class="space-y-6 lg:col-span-3">
                <fieldset class="card card-body">
                    <legend class="sr-only">{{ 'checkout.plan'|trans }}</legend>
                    <h2 class="font-semibold">{{ 'checkout.plan'|trans }}</h2>
                    <p class="mt-1 text-sm text-slate-500">{{ 'checkout.plan_help'|trans }}</p>
                    <div class="mt-4 grid gap-3">
                        {% for plan in plans %}
                            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/50">
                                <input type="radio" name="subscription" value="{{ plan.code }}" class="mt-1" {{ selected_plan == plan.code ? 'checked' }}>
                                <span class="flex-1">
                                    <span class="flex flex-wrap items-center justify-between gap-2"><span class="font-semibold">{{ plan.name(locale) }}{% if quote.subscriptionPlan and quote.subscriptionPlan.code == plan.code %} <span class="badge-brand">{{ 'checkout.recommended'|trans }}</span>{% endif %}</span><span class="font-semibold">{{ plan.monthlyPrice|money(quote.currency) }} / {{ 'pricing.month'|trans }}</span></span>
                                    <span class="mt-1 block text-sm text-slate-600">{{ plan.description(locale) }}</span>
                                </span>
                            </label>
                        {% endfor %}
                        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/50">
                            <input type="radio" name="subscription" value="none" class="mt-1" {{ selected_plan == 'none' ? 'checked' }}>
                            <span><span class="font-semibold">{{ 'checkout.no_plan'|trans }}</span><span class="mt-1 block text-sm text-slate-600">{{ 'checkout.no_plan_help'|trans }}</span></span>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="card card-body">
                    <legend class="sr-only">{{ 'checkout.payment_method'|trans }}</legend>
                    <h2 class="font-semibold">{{ 'checkout.payment_method'|trans }}</h2>
                    {% if providers is empty %}
                        <div class="alert-warning mt-4"><span>{{ 'checkout.error.payment_unavailable'|trans }}</span></div>
                    {% else %}
                        <div class="mt-4 grid gap-3">
                            {% for provider in providers %}
                                <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/50">
                                    <input type="radio" name="payment_provider" value="{{ provider.code }}" class="mt-1" {{ loop.first ? 'checked' }}>
                                    <span><span class="font-semibold">{{ ('checkout.methods.' ~ provider.driver ~ '.title')|trans }}</span><span class="mt-1 block text-sm text-slate-600">{{ ('checkout.methods.' ~ provider.driver ~ '.help')|trans }}</span></span>
                                </label>
                            {% endfor %}
                        </div>
                    {% endif %}
                </fieldset>
            </div>

            <aside class="lg:col-span-2">
                <div class="card card-body lg:sticky lg:top-24">
                    <p class="text-sm font-semibold text-brand-600">{{ quote.solution.icon }} {{ quote.solution.name(locale) }}</p>
                    <p class="text-sm text-slate-500">{{ project.name }} · {{ 'quote.number'|trans({'%number%': quote.number}) }}</p>
                    <ul class="mt-4 divide-y divide-slate-100 text-sm">
                        {% for item in quote.customerItems|filter(i => not i.recurring) %}
                            <li class="flex justify-between gap-3 py-2"><span>{{ item.label }}</span><span class="whitespace-nowrap font-medium">{{ item.price|money(quote.currency) }}</span></li>
                        {% endfor %}
                    </ul>
                    <p class="mt-4 flex items-end justify-between border-t border-slate-200 pt-4"><span class="font-semibold">{{ 'checkout.total_today'|trans }}</span><span class="text-2xl font-bold">{{ quote.sellingPrice|money(quote.currency) }}</span></p>
                    <label class="form-check-label mt-5 text-sm">
                        <input type="checkbox" name="accept_terms" value="1" required>
                        <span>{{ 'checkout.accept_terms'|trans({'%url%': path('legal_terms')})|raw }}</span>
                    </label>
                    <button type="submit" class="btn-primary btn-lg mt-5 w-full" {{ providers is empty ? 'disabled' }}>{{ 'checkout.pay'|trans({'%amount%': quote.sellingPrice|money(quote.currency)}) }}</button>
                    <p class="mt-4 text-xs text-slate-500">🔒 {{ 'checkout.approval_notice'|trans }}</p>
                </div>
            </aside>
        </form>
    </div>
</section>
{% endblock %}

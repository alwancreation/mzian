{% extends 'layouts/account.html.twig' %}

{% set locale = app.request.locale %}
{% block title %}{{ 'order.title'|trans({'%number%': order.number}) }}{% endblock %}
{% block page_title %}{{ 'order.title'|trans({'%number%': order.number}) }}{% endblock %}

{% block account_content %}
<div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        <div class="card card-body">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="{{ order.status.badge }}">{{ ('order.statuses.' ~ order.status.value)|trans }}</span>
                <a class="text-sm font-semibold text-brand-700 hover:underline" href="{{ path('account_project', {reference: project.reference}) }}">{{ project.name }} — {{ project.status.translationKey|trans }}</a>
            </div>

            {% if order.paid %}
                <div class="alert-success mt-5" data-testid="order-paid"><span>{{ 'order.paid_notice'|trans({'%date%': order.paidAt|format_datetime('medium', 'short', locale: locale)}) }}</span></div>
            {% elseif offline %}
                {% set settings = offline.provider.settings %}
                <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm" data-testid="bank-instructions">
                    <p class="font-semibold">{{ 'order.bank.title'|trans }}</p>
                    <dl class="mt-3 grid gap-2 sm:grid-cols-2">
                        <div><dt class="text-slate-500">{{ 'order.bank.amount'|trans }}</dt><dd class="font-semibold">{{ offline.payment.amount|money(offline.payment.currency) }}</dd></div>
                        <div><dt class="text-slate-500">{{ 'order.bank.reference'|trans }}</dt><dd class="font-mono font-semibold">{{ order.number }}</dd></div>
                        <div><dt class="text-slate-500">{{ 'order.bank.beneficiary'|trans }}</dt><dd>{{ settings.beneficiary|default('—') }}</dd></div>
                        <div><dt class="text-slate-500">{{ 'order.bank.bank'|trans }}</dt><dd>{{ settings.bank_name|default('—') }}</dd></div>
                        <div><dt class="text-slate-500">IBAN</dt><dd class="font-mono">{{ settings.iban|default('—') }}</dd></div>
                        <div><dt class="text-slate-500">BIC</dt><dd class="font-mono">{{ settings.bic|default('—') }}</dd></div>
                    </dl>
                    <p class="mt-3 text-slate-600">{{ 'order.bank.help'|trans }}</p>
                </div>
            {% elseif app.request.query.get('paid') and order.status.payable %}
                <div class="alert-info mt-5"><span>{{ 'order.payment_processing'|trans }}</span></div>
            {% endif %}

            <table class="mt-6 w-full text-sm">
                <tbody class="divide-y divide-slate-100">
                    {% for item in order.items|filter(i => not i.recurring) %}
                        <tr><td class="py-2 pe-3">{{ item.label }}</td><td class="whitespace-nowrap py-2 text-end">{{ item.total|money(order.currency) }}</td></tr>
                    {% endfor %}
                </tbody>
                <tfoot><tr class="border-t border-slate-200"><th class="pt-3 text-start">{{ 'order.total'|trans }}</th><td class="pt-3 text-end text-lg font-bold">{{ order.total|money(order.currency) }}</td></tr></tfoot>
            </table>
            {% if order.recurringMonthly > 0 %}
                <p class="mt-2 text-sm text-slate-500">{{ 'order.recurring'|trans({'%amount%': order.recurringMonthly|money(order.currency)}) }}</p>
            {% endif %}
        </div>

        {% if providers is not empty and not offline %}
            <form method="post" action="{{ path('account_order_pay', {number: order.number}) }}" class="card card-body">
                <input type="hidden" name="_token" value="{{ csrf_token('pay-' ~ order.number) }}">
                <h2 class="font-semibold">{{ 'order.pay_now'|trans }}</h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    {% for provider in providers %}
                        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 has-[:checked]:border-brand-500">
                            <input type="radio" name="payment_provider" value="{{ provider.code }}" class="mt-1" {{ loop.first ? 'checked' }}>
                            <span class="font-semibold">{{ ('checkout.methods.' ~ provider.driver ~ '.title')|trans }}</span>
                        </label>
                    {% endfor %}
                </div>
                <button class="btn-primary mt-4">{{ 'checkout.pay'|trans({'%amount%': order.total|money(order.currency)}) }}</button>
            </form>
        {% endif %}
    </div>

    <aside class="space-y-6">
        <div class="card card-body text-sm">
            <h2 class="font-semibold">{{ 'order.payments'|trans }}</h2>
            <ul class="mt-3 space-y-3">
                {% for payment in payments %}
                    <li class="flex items-start justify-between gap-2">
                        <span>{{ payment.createdAt|format_datetime('short', 'short', locale: locale) }}<span class="block text-xs text-slate-500">{{ ('checkout.methods.' ~ (payment.provider == 'stripe' ? 'stripe' : (payment.metadata.offline|default(false) ? 'manual' : 'mock')) ~ '.title')|trans }}</span>{% if payment.failureReason %}<span class="block text-xs text-red-600">{{ payment.failureReason }}</span>{% endif %}</span>
                        <span class="{{ payment.status.badge }}">{{ ('payment.statuses.' ~ payment.status.value)|trans }}</span>
                    </li>
                {% else %}
                    <li class="text-slate-500">—</li>
                {% endfor %}
            </ul>
        </div>
        {% if invoice %}
            <a class="card card-body block text-sm hover:border-brand-300" href="{{ path('account_invoice', {number: invoice.number}) }}">📄 {{ 'order.invoice'|trans({'%number%': invoice.number}) }}</a>
        {% endif %}
    </aside>
</div>
{% endblock %}

{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
<section class="section bg-gradient-to-b from-brand-50/60 to-white">
    <div class="container-page max-w-md">
        <div class="card card-body">
            <h1 class="text-2xl font-bold">{{ 'login.title'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-600">{{ 'login.subtitle'|trans }}</p>

            {% if error %}
                <div class="alert-error mt-5" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('login') }}" class="mt-6">
                <div class="form-row">
                    <label class="form-label" for="email">{{ 'form.email'|trans }}</label>
                    <input class="form-input" type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="form-row">
                    <label class="form-label" for="password">{{ 'form.password'|trans }}</label>
                    <input class="form-input" type="password" id="password" name="password" autocomplete="current-password" required>
                </div>
                <label class="mb-5 flex items-center gap-2 text-sm text-slate-600">
                    <input type="checkbox" name="_remember_me" class="form-check"> {{ 'login.remember_me'|trans }}
                </label>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_target_path" value="{{ app.request.query.get('target')|default('') }}">
                <button type="submit" class="btn-primary w-full">{{ 'login.submit'|trans }}</button>
            </form>
            <p class="mt-6 text-center text-sm text-slate-600">
                {{ 'login.no_account'|trans }}
                <a class="font-semibold text-brand-700 hover:underline" href="{{ path('register', app.request.query.get('target') ? {target: app.request.query.get('target')} : {}) }}">{{ 'login.create_account'|trans }}</a>
            </p>
        </div>
    </div>
</section>
{% endblock %}

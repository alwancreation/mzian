{% extends 'layouts/public.html.twig' %}

{% set locale = app.request.locale %}
{% block title %}{{ 'analysis.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block seo_links %}{% endblock %}

{% block content %}
<section class="bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page max-w-4xl py-8 sm:py-12">
        {% include 'start/_steps.html.twig' with {current: 'proposal'} %}
        <div class="card card-body">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <p class="text-sm font-semibold text-brand-600">🤖 {{ 'analysis.recommended'|trans }}</p>
                    <h1 class="mt-1 text-3xl font-bold">{{ solution ? solution.icon ~ ' ' ~ solution.name(locale) : analysis.solution }}</h1>
                    {% if solution %}<p class="mt-1 text-slate-600">{{ solution.shortDescription(locale) }}</p>{% endif %}
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="badge-violet">{{ ('analysis.complexity.' ~ analysis.complexity)|trans }}</span>
                    <span class="badge-blue">⏱ {{ 'catalog.days'|trans({'%count%': analysis.estimatedDevelopmentDays}) }}</span>
                </div>
            </div>
            <p class="mt-6 rounded-xl bg-brand-50/60 p-4 text-slate-700">{{ analysis.recommendation }}</p>

            <h2 class="mt-8 font-semibold">{{ 'analysis.features'|trans }}</h2>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {% for code in analysis.features %}
                    {% set feature = solution ? solution.feature(code) : null %}
                    <li class="flex items-center gap-2 text-sm"><span class="text-accent-600">✓</span>{{ feature ? feature.name(locale) : code|replace({'_': ' '})|capitalize }}{% if feature and not feature.included %}<span class="badge-gray">{{ 'catalog.on_request'|trans }}</span>{% endif %}</li>
                {% endfor %}
            </ul>
            {% if analysis.unsupportedFeatures is not empty %}
                <div class="alert-info mt-6">
                    <span>{{ 'analysis.custom_notice'|trans({'%features%': analysis.unsupportedFeatures|map(f => f|replace({'_': ' '}))|join(', ')}) }}</span>
                </div>
            {% endif %}

            {% block analysis_pricing %}
                {% set order = project ? project.order : null %}
                {% if quote %}
                    {% set snapshot = quote.pricingSnapshot %}
                    {% set domain = snapshot.domain|default({mode: 'none', name: null, requested: null}) %}
                    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6" aria-labelledby="proposal-price">
                        <div class="flex flex-wrap items-end justify-between gap-3">
                            <div>
                                <h2 id="proposal-price" class="font-semibold">{{ 'pricing.proposal.title'|trans }} <span class="text-xs font-normal text-slate-400">{{ 'quote.number'|trans({'%number%': quote.number}) }}</span></h2>
                                <p class="text-sm text-slate-500">{{ 'pricing.proposal.one_time'|trans }}</p>
                            </div>
                            <p class="text-4xl font-bold text-ink" data-testid="proposal-total">{{ quote.sellingPrice|money(quote.currency, false) }}</p>
                        </div>

                        <table class="mt-5 w-full text-sm">
                            <caption class="sr-only">{{ 'pricing.proposal.details'|trans }}</caption>
                            <tbody class="divide-y divide-slate-100">
                                {% for item in quote.customerItems|filter(i => not i.recurring) %}
                                    <tr><td class="py-2 pe-3">{{ item.label }}</td><td class="whitespace-nowrap py-2 text-end font-medium">{{ item.price|money(quote.currency) }}</td></tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr class="border-t border-slate-200"><th scope="row" class="pt-3 text-start">{{ 'pricing.proposal.total'|trans }}</th><td class="pt-3 text-end text-lg font-bold">{{ quote.sellingPrice|money(quote.currency) }}</td></tr>
                            </tfoot>
                        </table>

                        <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
                            <div class="rounded-xl bg-slate-50 p-3">
                                <dt class="text-slate-500">🌐 {{ 'pricing.proposal.domain'|trans }}</dt>
                                <dd class="mt-1 font-medium">
                                    {% if domain.mode == 'own' %}{{ 'pricing.domain.own'|trans({'%domain%': domain.name ?? '—'}) }}
                                    {% elseif domain.mode == 'register' %}{{ 'pricing.domain.register'|trans({'%domain%': domain.name}) }}{% if domain.requested and domain.requested != domain.name %}<span class="block text-xs font-normal text-amber-700">{{ 'pricing.domain.alternative'|trans({'%domain%': domain.requested}) }}</span>{% endif %}
                                    {% elseif domain.mode == 'none' %}{{ 'pricing.domain.none'|trans }}
                                    {% else %}{{ 'pricing.domain.to_choose'|trans }}{% endif %}
                                </dd>
                            </div>
                            {% if quote.hostingPlan %}
                                <div class="rounded-xl bg-slate-50 p-3">
                                    <dt class="text-slate-500">☁️ {{ 'pricing.proposal.hosting'|trans }}</dt>
                                    <dd class="mt-1 font-medium">{{ quote.hostingPlan.name }}</dd>
                                </div>
                            {% endif %}
                        </dl>

                        {% if quote.subscriptionPlan %}
                            <div class="mt-4 rounded-xl border border-brand-100 bg-brand-50/50 p-4 text-sm">
                                <p class="font-semibold">{{ 'pricing.proposal.then'|trans({'%price%': quote.recurringMonthly|money(quote.currency), '%plan%': quote.subscriptionPlan.name(locale)}) }}</p>
                                <p class="mt-1 text-slate-600">{{ quote.subscriptionPlan.description(locale) }} {{ 'pricing.proposal.subscription_optional'|trans }}</p>
                            </div>
                        {% endif %}

                        {% for warning in snapshot.warnings|default([]) %}
                            <div class="alert-info mt-4"><span>{{ warning|trans }}</span></div>
                        {% endfor %}

                        {% if order %}
                            <div class="alert-success mt-6">
                                <span>{{ 'quote.ordered'|trans({'%number%': order.number}) }}</span>
                            </div>
                            {% if app.user and order.customer.user == app.user %}
                                <a href="{{ path('account_order', {number: order.number}) }}" class="btn-primary btn-lg mt-4 w-full">{{ 'quote.view_order'|trans }}</a>
                            {% endif %}
                        {% elseif quote.expired %}
                            <div class="alert-warning mt-6"><span>{{ 'quote.expired'|trans({'%date%': quote.validUntil|format_date('long', locale: locale)}) }}</span></div>
                            <form method="post" action="{{ path('start_analyze', {token: requirement.token}) }}" class="mt-4">
                                <input type="hidden" name="_token" value="{{ csrf_token('analyze-' ~ requirement.token) }}">
                                <button class="btn-primary btn-lg w-full">{{ 'quote.refresh'|trans }}</button>
                            </form>
                        {% else %}
                            <p class="mt-5 text-xs text-slate-500">{{ 'quote.valid_until'|trans({'%date%': quote.validUntil|format_date('long', locale: locale)}) }} {{ 'pricing.proposal.approval'|trans }}</p>
                            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                                <a href="{{ path('order_checkout', {token: quote.token}) }}" class="btn-primary btn-lg sm:flex-1" data-testid="order-button">{{ 'pricing.proposal.order'|trans }} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span></a>
                                <a href="{{ path('contact') }}" class="btn-secondary btn-lg sm:flex-1">{{ 'pricing.proposal.question'|trans }}</a>
                            </div>
                        {% endif %}
                    </section>
                {% elseif open %}
                    <div class="alert-info mt-8"><span>{{ 'quote.unavailable'|trans }}</span></div>
                    <a href="{{ path('contact') }}" class="btn-secondary mt-4">{{ 'pricing.proposal.question'|trans }}</a>
                {% endif %}
            {% endblock %}

            <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-6 text-sm">
                {% if open %}<a href="{{ path('start_details', {token: requirement.token}) }}" class="btn-ghost">✏️ {{ 'start.summary.edit'|trans }}</a>{% else %}<span></span>{% endif %}
                <span class="text-xs text-slate-400">{{ analysis.engine starts with 'ai:' ? 'analysis.engine_ai'|trans : 'analysis.engine_rules'|trans }}{% if analysis.fallbackUsed %} · {{ 'analysis.fallback'|trans }}{% endif %}</span>
            </div>
        </div>
    </div>
</section>
{% endblock %}

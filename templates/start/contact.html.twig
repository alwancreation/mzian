{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'start.contact.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}
{% block seo_links %}{% endblock %}

{% block content %}
<section class="bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page max-w-2xl py-8 sm:py-12">
        {% include 'start/_steps.html.twig' with {current: 'contact'} %}
        <div class="card card-body">
            <h1 class="text-2xl font-bold">{{ 'start.contact.title'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-600">{{ 'start.contact.lead'|trans }}</p>
            <div class="mt-6">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.fullName) }}
                    <div class="grid gap-x-5 sm:grid-cols-2">
                        {{ form_row(form.email) }}
                        {{ form_row(form.phone) }}
                    </div>
                    {{ form_row(form.acceptPrivacy) }}
                    {{ form_row(form.marketingConsent) }}
                    <div class="flex items-center justify-between gap-3">
                        <a href="{{ path('start_details', {token: requirement.token}) }}" class="btn-ghost"><span class="inline-block rtl:-scale-x-100" aria-hidden="true">←</span> {{ 'action.back'|trans }}</a>
                        <button class="btn-primary btn-lg">{{ 'start.contact.submit'|trans }} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span></button>
                    </div>
                {{ form_end(form) }}
            </div>
            <ul class="mt-6 grid gap-2 border-t border-slate-100 pt-5 text-sm text-slate-600 sm:grid-cols-3">
                <li>✓ {{ 'start.contact.reassurance.free'|trans }}</li>
                <li>✓ {{ 'start.contact.reassurance.no_commitment'|trans }}</li>
                <li>✓ {{ 'start.contact.reassurance.no_spam'|trans }}</li>
            </ul>
        </div>
    </div>
</section>
{% endblock %}

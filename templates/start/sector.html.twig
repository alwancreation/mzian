{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'start.sector.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'start.sector.lead'|trans }}{% endblock %}

{% block content %}
<section class="bg-gradient-to-b from-brand-50/70 to-white">
    <div class="container-page max-w-4xl py-10 sm:py-14">
        {% include 'start/_steps.html.twig' with {current: 'sector'} %}
        <h1 class="text-3xl font-bold sm:text-4xl">{{ 'start.sector.title'|trans }}</h1>
        <p class="mt-2 text-slate-600">{{ 'start.sector.lead'|trans }}</p>

        <form method="post" class="mt-8" data-autosubmit>
            <input type="hidden" name="_token" value="{{ csrf_token('start') }}">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                {% for sector in sectors %}
                    <label class="choice flex-col items-start gap-1 sm:p-5">
                        <input type="radio" name="sector" value="{{ sector.code }}" class="sr-only" {{ preselected == sector.code ? 'checked' }} required>
                        <span class="text-2xl" aria-hidden="true">{{ sector.icon }}</span>
                        <span class="font-semibold">{{ sector.name(app.request.locale) }}</span>
                        <span class="hidden text-xs text-slate-500 sm:block">{{ sector.description(app.request.locale) }}</span>
                    </label>
                {% endfor %}
            </div>
            <div class="sticky bottom-0 mt-6 bg-gradient-to-t from-white via-white to-transparent py-4">
                <button class="btn-primary btn-lg w-full sm:w-auto">{{ 'action.continue'|trans }} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span></button>
            </div>
        </form>
        {% if route_exists('chat.fr') %}
            <p class="mt-2 text-sm text-slate-600">{{ 'start.sector.or_chat'|trans }} <a class="font-semibold text-brand-700 hover:underline" href="{{ path('chat') }}">{{ 'start.sector.chat_link'|trans }}</a></p>
        {% endif %}
    </div>
</section>
{% endblock %}

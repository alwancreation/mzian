{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'contact.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'contact.lead'|trans }}{% endblock %}

{% block content %}
{% include 'components/_page_header.html.twig' with {eyebrow: 'nav.contact'|trans, title: 'contact.title'|trans, lead: 'contact.lead'|trans} %}
<section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <div class="card card-body">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="grid gap-x-5 sm:grid-cols-2">
                        {{ form_row(form.name) }}
                        {{ form_row(form.email) }}
                    </div>
                    {{ form_row(form.phone) }}
                    {{ form_row(form.message) }}
                    {{ form_widget(form.website) }}
                    <button type="submit" class="btn-primary">{{ 'contact.send'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>
        <aside class="space-y-4">
            <div class="card card-body">
                <h2 class="font-semibold">{{ 'contact.faster.title'|trans }}</h2>
                <p class="mt-2 text-sm text-slate-600">{{ 'contact.faster.text'|trans }}</p>
                <a href="{{ path('register') }}" class="btn-primary mt-4 w-full">{{ 'cta.start_free'|trans }}</a>
            </div>
            <div class="card card-body text-sm text-slate-600">
                <p class="font-semibold text-ink">Mzian.net</p>
                <p class="mt-2">{{ 'contact.response_time'|trans }}</p>
            </div>
        </aside>
    </div>
</section>
{% endblock %}

{% extends 'layouts/public.html.twig' %}

{% block title %}{{ 'how.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'how.lead'|trans }}{% endblock %}

{% block content %}
{% include 'components/_page_header.html.twig' with {eyebrow: 'nav.how_it_works'|trans, title: 'how.title'|trans, lead: 'how.lead'|trans} %}
<section class="section">
    <div class="container-page">
        <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for step in ['describe', 'questions', 'analysis', 'proposal', 'order', 'validation', 'build', 'quality', 'delivery'] %}
                <li class="card card-body">
                    <div class="flex items-center gap-3">
                        <span class="stepper-dot bg-brand-600 text-white">{{ loop.index }}</span>
                        <h2 class="font-semibold">{{ ('how.steps.' ~ step ~ '.title')|trans }}</h2>
                    </div>
                    <p class="mt-3 text-sm text-slate-600">{{ ('how.steps.' ~ step ~ '.text')|trans }}</p>
                </li>
            {% endfor %}
        </ol>

        <div class="mt-16 grid gap-8 lg:grid-cols-2">
            <div class="card card-body">
                <h2 class="text-xl font-semibold">{{ 'how.human.title'|trans }}</h2>
                <p class="mt-3 text-slate-600">{{ 'how.human.text'|trans }}</p>
            </div>
            <div class="card card-body">
                <h2 class="text-xl font-semibold">{{ 'how.safety.title'|trans }}</h2>
                <ul class="mt-3 space-y-2 text-slate-600">
                    {% for item in ['budget', 'secrets', 'tests', 'audit'] %}
                        <li class="flex gap-2"><span class="text-accent-600">✓</span>{{ ('how.safety.' ~ item)|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="mt-12 text-center">
            <a href="{{ path('start') }}" class="btn-primary btn-lg btn-glow">{{ 'cta.start_free'|trans }}</a>
        </div>
    </div>
</section>
{% endblock %}

{% extends 'layouts/public.html.twig' %}
{% block title %}{{ 'legal.privacy.title'|trans }}{% endblock %}
{% block content %}
{% include 'components/_page_header.html.twig' with {title: 'legal.privacy.title'|trans} %}
<section class="section">
    <div class="container-page prose-simple max-w-3xl text-slate-700">
        {% for section in ['data', 'analytics', 'ai', 'security', 'rights'] %}
            <h2>{{ ('legal.privacy.' ~ section ~ '.title')|trans }}</h2>
            <p>{{ ('legal.privacy.' ~ section ~ '.text')|trans }}</p>
        {% endfor %}
        <p class="mt-8 text-sm text-slate-500">{{ 'legal.placeholder_notice'|trans }}</p>
    </div>
</section>
{% endblock %}
